# Contact form email delivery. Set these in Vercel: Project > Settings > Environment Variables.
# Never commit real values.

# API key from https://resend.com
RESEND_API_KEY=

# The inbox that receives website enquiries
CONTACT_TO_EMAIL=

# Sender address on a domain verified with Resend, for example: Weavy Website <website@your-domain>
CONTACT_FROM_EMAIL=
